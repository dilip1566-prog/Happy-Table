rules_version = '2';

// ===========================================================================
// Multi-tenant isolation.
//
// Every restaurant's data lives under restaurants/{rid}. A signed-in staff
// member has a document at restaurants/{rid}/staff/{uid}; that document IS
// their authorisation. One `staffOf(rid)` lookup answers three questions at
// once: do they belong to this restaurant, are they still employed, and what
// may they do.
//
// This deliberately avoids custom claims, which would need the Admin SDK and
// therefore Cloud Functions and the Blaze plan. The trade is one extra
// document read per rule evaluation — acceptable at this scale, and it keeps
// a leaver's access removable with a single Firestore write.
//
// Seeding deliberately cannot happen through these rules: a restaurant may
// only be created by a platform admin, a menu only by a manager, and an
// owner's own staff document only by an owner — which cannot exist before
// that document does. scripts/seed.js therefore runs on the Admin SDK and
// bypasses this file. Nothing a guest or staff member touches does.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---------------------------------------------------------

    function staffDoc(rid) {
      return get(/databases/$(database)/documents/restaurants/$(rid)/staff/$(request.auth.uid));
    }

    // Employed here, right now. isActive is the whole revocation mechanism:
    // flip it false and the next request fails, with no token to revoke.
    function isStaff(rid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/restaurants/$(rid)/staff/$(request.auth.uid))
        && staffDoc(rid).data.isActive == true;
    }

    function roleOf(rid) {
      return staffDoc(rid).data.role;
    }

    function isOwner(rid) {
      return isStaff(rid) && roleOf(rid) == 'owner';
    }

    function isManagerUp(rid) {
      return isStaff(rid) && roleOf(rid) in ['owner', 'manager'];
    }

    // Us, not them. Written once by the seeder's --admin flag, or by hand
    // in the console; never writable from the app.
    function isPlatformAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // --- the restaurant record -------------------------------------------

    match /restaurants/{rid} {
      // A guest must be able to resolve a subdomain before signing in to
      // anything, so the record itself is public — and a restaurant on its
      // own domain is resolved by querying customDomain across the whole
      // collection, which needs list access too.
      //
      // Keep it to presentation fields. Never put billing, subscription or
      // contact details on this document: it is readable by the entire
      // internet, and no rule below can narrow that afterwards.
      allow read: if true;
      allow create, delete: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || isOwner(rid);

      // --- menu ----------------------------------------------------------
      match /menuItems/{itemId} {
        allow read: if true;                       // guests browse freely
        // A platform admin writes menus too, and has to: the operator
        // console loads a restaurant's menu during onboarding, before any
        // manager account exists to do it. Loading a menu from a spreadsheet
        // is the single biggest cost of getting a restaurant live, so it
        // cannot wait for the owner to first sign in.
        allow write: if isManagerUp(rid) || isPlatformAdmin();
      }

      // --- tables ----------------------------------------------------------
      match /tables/{tableId} {
        allow read: if true;

        // A guest scanning a QR may knock, and nothing else: available ->
        // pending_approval, with no other field touched.
        allow update: if isStaff(rid)
          || (
            resource.data.status == 'available'
            && request.resource.data.status == 'pending_approval'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          );

        // Platform admin included, because a new restaurant is created with
        // its tables already numbered — a restaurant with no tables cannot
        // seat anybody, so provisioning that stopped short of this would
        // hand over something that looks ready and is not.
        allow create, delete: if isManagerUp(rid) || isPlatformAdmin();
      }

      // --- sessions --------------------------------------------------------
      match /sessions/{sessionId} {
        // Guests need this to redeem a table code. The access_code is
        // readable, which is why a code alone must never be enough to see
        // anything private — it only attaches a device to a table.
        allow read: if true;
        allow create, update: if isStaff(rid);
        allow delete: if false;                    // closed, never destroyed
      }

      // --- orders ----------------------------------------------------------
      match /orders/{orderId} {
        allow read: if true;

        // A guest may place an order against an ACTIVE session only, and it
        // must start as pending with real line items. They may never edit
        // one afterwards — only the kitchen moves a ticket.
        allow create: if isStaff(rid)
          || (
            request.resource.data.status == 'pending'
            && request.resource.data.session_id is string
            && request.resource.data.items.size() > 0
            && exists(/databases/$(database)/documents/restaurants/$(rid)/sessions/$(request.resource.data.session_id))
            && get(/databases/$(database)/documents/restaurants/$(rid)/sessions/$(request.resource.data.session_id)).data.status == 'active'
          );

        allow update: if isStaff(rid);
        allow delete: if false;                    // cancel, do not erase
      }

      // --- config: inventory and the permission matrix ----------------------
      match /config/{docId} {
        // Guests read the 86 list so sold-out dishes grey out live.
        allow read: if true;
        // Only the owner may change who can do what — plus a platform admin,
        // who writes the starting matrix when the restaurant is created. No
        // owner account exists at that moment, so without this a new
        // restaurant would come up with no permissions at all and its first
        // sign-in would land on a padlock.
        allow write: if isPlatformAdmin()
          || (docId == 'access' ? isOwner(rid) : isStaff(rid));
      }

      // --- staff ------------------------------------------------------------
      match /staff/{uid} {
        // Staff see their colleagues; guests see nobody. Email addresses and
        // roles are not public.
        allow read: if isStaff(rid);

        // Only the owner hires, changes roles, or deactivates. Note a person
        // cannot edit their own record — that would let a waiter promote
        // themselves.
        allow create, delete: if isOwner(rid) || isPlatformAdmin();

        // One exception, as narrow as it can be written: on first sign-in a
        // person may clear their OWN mustSetPassword flag, and change
        // nothing else. Firebase completes a password reset without telling
        // the app, so that first sign-in is the only moment anything knows
        // they are no longer waiting to choose one.
        //
        // hasOnly() pins it to that single key and the == false pins the
        // direction, so this cannot carry a role change, a reactivation or
        // any other field in alongside it. Without it the rule above denies
        // the write and the owner's People screen shows "Invited" against
        // someone who signed in weeks ago.
        allow update: if isOwner(rid) || isPlatformAdmin()
          || (
            request.auth != null
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustSetPassword'])
            && request.resource.data.mustSetPassword == false
          );
      }
    }

    // --- platform ----------------------------------------------------------

    match /platformAdmins/{uid} {
      // Readable by the account itself so the operator console can check.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Never writable from a client. This is the line the whole tenancy
      // model rests on: no account can promote itself to platform admin, so
      // no restaurant can reach another restaurant's data.
      allow write: if false;

      // -------------------------------------------------------------------
      // ONE-TIME BOOTSTRAP — deliberately committed in disarmed form.
      // -------------------------------------------------------------------
      // A brand new project has no platform admin, and the line above means
      // no client can create the first one. The options are an Admin SDK key
      // (scripts/seed.js), writing the document by hand in the console, or
      // temporarily pasting the block below into the console WITH a real
      // address and a near-future date, claiming once, then publishing this
      // file again to close it.
      //
      // It stays commented out here on purpose. This repository is public,
      // and an armed window plus a known address is a standing invitation —
      // Firebase Email/Password signup does NOT verify that the person
      // registering an address owns it, so anyone holding the project's web
      // API key could register the named address themselves, provided no
      // account for it exists yet. The window is only safe while the account
      // already exists and is one you control.
      //
      //   allow create: if request.auth != null
      //     && request.auth.uid == uid
      //     && request.auth.token.email == 'you@example.com'
      //     && request.time < timestamp.date(2026, 1, 1);
      //   allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
