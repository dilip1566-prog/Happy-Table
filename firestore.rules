rules_version = '2';

// ---------------------------------------------------------------------------
// STARTING POINT ONLY - these rules are open enough to run the app on a closed
// restaurant Wi-Fi, and are NOT safe for the public internet as written.
// Anyone who can reach the project can currently seat themselves and edit the
// menu. Before going live, put the manager and kitchen surfaces behind Firebase
// Auth and gate the write rules below on request.auth.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Tables: any device may read, and a customer may only move a table from
    // "available" to "pending_approval". Promotion to "occupied" is a staff
    // action, which is the one thing this ruleset does pin down.
    match /tables/{tableId} {
      allow read: if true;

      allow update: if
        // customer knock
        (resource.data.status == 'available'
         && request.resource.data.status == 'pending_approval'
         && request.resource.data.table_number == resource.data.table_number)
        // staff actions (seat, dismiss, free) - lock this to request.auth != null
        || true;

      allow create, delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;  // lock to staff auth
      allow delete: if false;
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if true;           // lock to staff auth
    }

    match /store_config/{docId} {
      allow read: if true;
      allow write: if true;           // lock to staff auth
    }

    match /orders/{orderId} {
      allow read: if true;

      // An order must be created as "pending" with a session and line items.
      allow create: if
        request.resource.data.status == 'pending'
        && request.resource.data.session_id is string
        && request.resource.data.items.size() > 0;

      allow update: if true;          // lock to staff auth
      allow delete: if false;
    }
  }
}
